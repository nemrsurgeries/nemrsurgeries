# ─── Database (PostgreSQL / Neon) ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ortho_cases?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/ortho_cases?schema=public"

# ─── Application & Authentication ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="replace-with-32-byte-cryptographically-random-secret"

# ─── Transactional Email ──────────────────────────────────────────────────────
# "console" logs emails to server stdout in development; "resend" sends via Resend API
EMAIL_PROVIDER="console"
EMAIL_FROM="OrthoCase <noreply@example.com>"
RESEND_API_KEY=""

# ─── Private Object Storage (S3-Compatible) ───────────────────────────────────
# "local" is allowed only in non-production development; use "s3" in staging/production
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
MAX_UPLOAD_SIZE_MB="20"
SIGNED_URL_TTL_SECONDS="300"

# ─── Invitations & Security ───────────────────────────────────────────────────
INVITATION_EXPIRY_DAYS="7"
LOCAL_STORAGE_SIGNING_SECRET="replace-with-dev-only-signing-secret"
